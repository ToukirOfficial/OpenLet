# OpenLet settings. Copy to .env and fill in. Every setting is read by the API and the worker;
# the web app only needs API_INTERNAL_URL and WEB_PORT.

# --- General ---
NODE_ENV=development
# Public URL of the web app, used in email links and to check where requests come from.
APP_URL=http://localhost:8030
WEB_PORT=8030
API_PORT=8130
API_HOST=127.0.0.1
# Where the web server forwards /api/* (the browser only ever talks to APP_URL).
API_INTERNAL_URL=http://127.0.0.1:8130

# --- Database and Redis ---
DATABASE_URL=postgresql://openlet:openlet@127.0.0.1:5432/openlet
# Separate database for the test suite. Its name must end in _test (it is wiped on every run).
TEST_DATABASE_URL=postgresql://openlet:openlet@127.0.0.1:5432/openlet_test
REDIS_URL=redis://127.0.0.1:6379/14
# Every Redis key and queue starts with this, so OpenLet can share a Redis server.
REDIS_PREFIX=openlet

# --- Security ---
# Long random string: openssl rand -base64 48
JWT_SECRET=
# Set to false only for local testing over plain http.
COOKIE_SECURE=true

# --- Sign-up and demo ---
# Off: only the first-run setup creates a workspace. On: anyone can create one (hosted service).
SIGNUP_ENABLED=false
# Demo site only: fake data, one-click logins, emails captured (never sent), small uploads, nightly reset.
DEMO_MODE=false

# --- Email ---
# log = written to the worker log instead of sent; smtp = send with the SMTP_* settings below.
MAIL_TRANSPORT=log
MAIL_FROM="OpenLet <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (TLS from the start); false uses STARTTLS on 587.
SMTP_SECURE=false

# --- Files ---
# Private folder for uploads and exports, outside any public web root. Back it up with the database.
STORAGE_DIR=./storage
UPLOAD_MAX_MB=15

# --- Repairs ---
# Days a contractor link keeps working after its repair is closed.
CONTRACTOR_LINK_GRACE_DAYS=7

# --- Proxies ---
# Which proxies to trust for the visitor's IP address (used for rate limits and the audit log).
# Same machine: loopback. Docker Compose: loopback, uniquelocal
TRUST_PROXY=loopback

# --- Docker Compose only ---
# Password for the bundled PostgreSQL (docker-compose.yml builds DATABASE_URL from it).
POSTGRES_PASSWORD=change-me
