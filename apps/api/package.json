{
  "name": "@openlet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json -w --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js & node --env-file-if-exists=../../.env --watch dist/worker.js)",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env dist/seed.js",
    "db:reset": "prisma migrate reset --force && pnpm build && pnpm db:seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@openlet/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.4",
    "csv-stringify": "^6.9.0",
    "file-type": "^22.3.0",
    "heic-convert": "^2.1.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/heic-convert": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
