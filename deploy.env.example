# Copy to deploy.env (git-ignored) and fill in. Never commit server details: this repo is public.
# SSH alias (in ~/.ssh/config) that logs in, with a key, as the user that owns the PM2 processes.
SSH_HOST=your-ssh-alias
# Where releases live on the server (it holds releases/, current and shared/api.env), and where database backups go.
APP_DIR=/path/to/app
BACKUP_DIR=/path/to/backups
# Public URL, checked after each deploy.
SITE_URL=https://example.com
# Local ports the apps listen on (127.0.0.1 only; nginx proxies the site to WEB_PORT).
WEB_PORT=3000
API_PORT=4000
# PM2 process name prefix and memory limits.
PM2_PREFIX=openlet
WEB_MAX_MEMORY=300M
API_MAX_MEMORY=300M
WORKER_MAX_MEMORY=350M
# Optional: branch the server clones (default main).
# BRANCH=main
