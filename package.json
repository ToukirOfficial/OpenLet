{
  "name": "openlet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @openlet/api db:migrate",
    "db:seed": "pnpm --filter @openlet/api db:seed",
    "db:reset": "pnpm --filter @openlet/api db:reset",
    "worker": "pnpm --filter @openlet/api worker",
    "scan": "scripts/scan-secrets.sh --all"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=10 <11.0.1": "^11.0.4"
    }
  }
}
